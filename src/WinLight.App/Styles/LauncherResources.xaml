<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WinLightTransparentBrush" Color="Transparent" />

    <Style x:Key="WinLightSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="56" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,12,0,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="WinLightResultContainerStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <DataTemplate x:Key="WinLightResultTemplate">
        <StackPanel AutomationProperties.Name="{Binding Name}">
            <Grid Height="28" Visibility="{Binding SectionHeaderVisibility}"
                  IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                <TextBlock Text="{Binding SectionHeader}" Margin="16,0,16,0"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Tag="WinLightSelectionPill"
                        Width="3" Height="24" Margin="8,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="2" Visibility="Collapsed"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" />
                <Image Grid.Column="1" Source="{Binding Icon}" Width="32" Height="32"
                       VerticalAlignment="Center" Stretch="Uniform"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Grid.Column="3" Text="{Binding Name}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="WinLightCalculatorTemplate">
        <Grid Height="48" AutomationProperties.Name="{Binding AccessibleName}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Tag="WinLightSelectionPill"
                    Width="3" Height="24" Margin="8,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    CornerRadius="2" Visibility="Collapsed"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
            <FontIcon Grid.Column="1" Glyph="&#xE8EF;" FontFamily="Segoe Fluent Icons" FontSize="20"
                      VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="{Binding Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WinLightFileTemplate">
        <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
            <Grid Height="28" Visibility="{Binding SectionHeaderVisibility}"
                  IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                <TextBlock Text="{Binding SectionHeader}" Margin="16,0,16,0"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Tag="WinLightSelectionPill"
                        Width="3" Height="24" Margin="8,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        CornerRadius="2" Visibility="Collapsed"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" />
                <Image Grid.Column="1" Source="{Binding Icon}" Width="32" Height="32"
                       VerticalAlignment="Center" Stretch="Uniform"
                       AutomationProperties.AccessibilityView="Raw" />
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{Binding Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
